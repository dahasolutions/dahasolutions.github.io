{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SideLedger TaxYearConfig (schema v2)",
  "type": "object",
  "required": [
    "schemaVersion", "year", "configVersion", "mileageRates",
    "seTax", "standardDeductionCents", "qbi", "brackets",
    "quarterDeadlines", "safeHarbor"
  ],
  "definitions": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "filingAmounts": {
      "type": "object",
      "required": ["single", "mfj", "hoh"],
      "additionalProperties": false,
      "properties": {
        "single": { "type": "integer", "minimum": 0 },
        "mfj": { "type": "integer", "minimum": 0 },
        "hoh": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 2 },
    "year": { "type": "integer", "minimum": 2025, "maximum": 2100 },
    "configVersion": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string" },
    "sources": { "type": "object" },
    "mileageRates": {
      "type": "array",
      "minItems": 1,
      "description": "Standard mileage rate in tenths of a cent (72.5 cents/mile => 725), in force from `from` until the next entry starts. The IRS has changed the rate mid-year before (2008, 2011, 2022, 2026). Sanity bounds 30c-150c.",
      "items": {
        "type": "object",
        "required": ["from", "tenthCents"],
        "additionalProperties": false,
        "properties": {
          "from": { "$ref": "#/definitions/isoDate" },
          "tenthCents": { "type": "integer", "minimum": 300, "maximum": 1500 }
        }
      }
    },
    "seTax": {
      "type": "object",
      "required": ["adjustment", "socialSecurityRate", "medicareRate", "ssWageBaseCents", "additionalMedicare"],
      "properties": {
        "adjustment": { "type": "number", "minimum": 0.9, "maximum": 1.0 },
        "socialSecurityRate": { "type": "number", "minimum": 0.1, "maximum": 0.15 },
        "medicareRate": { "type": "number", "minimum": 0.02, "maximum": 0.05 },
        "ssWageBaseCents": { "type": "integer", "minimum": 10000000, "maximum": 50000000 },
        "additionalMedicare": {
          "type": "object",
          "required": ["rate", "thresholdCents"],
          "properties": {
            "rate": { "type": "number", "minimum": 0, "maximum": 0.05 },
            "thresholdCents": { "$ref": "#/definitions/filingAmounts" }
          }
        }
      }
    },
    "standardDeductionCents": {
      "type": "object",
      "required": ["single", "mfj", "hoh"],
      "properties": {
        "single": { "type": "integer", "minimum": 500000, "maximum": 10000000 },
        "mfj": { "type": "integer", "minimum": 1000000, "maximum": 20000000 },
        "hoh": { "type": "integer", "minimum": 500000, "maximum": 15000000 }
      }
    },
    "qbi": {
      "type": "object",
      "description": "IRC 199A for a sole proprietor with no W-2 wages or UBIA: deduction = rate x QBI, phased out linearly over phaseInRangeCents above thresholdCents (199A(b)(3)(B)), capped at rate x taxable income before the deduction (199A(a)), and never below minimumDeductionCents when QBI is at least minimumQualifyingBaseCents (199A(i), tax years after 2025).",
      "required": ["rate", "thresholdCents", "phaseInRangeCents", "minimumDeductionCents", "minimumQualifyingBaseCents"],
      "additionalProperties": false,
      "properties": {
        "rate": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "thresholdCents": { "$ref": "#/definitions/filingAmounts" },
        "phaseInRangeCents": {
          "type": "object",
          "required": ["single", "mfj", "hoh"],
          "additionalProperties": false,
          "properties": {
            "single": { "type": "integer", "minimum": 1 },
            "mfj": { "type": "integer", "minimum": 1 },
            "hoh": { "type": "integer", "minimum": 1 }
          }
        },
        "minimumDeductionCents": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "minimumQualifyingBaseCents": { "type": "integer", "minimum": 0, "maximum": 10000000 }
      }
    },
    "brackets": {
      "type": "object",
      "required": ["single", "mfj", "hoh"],
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "required": ["upToCents", "rate"],
          "properties": {
            "upToCents": { "type": ["integer", "null"], "minimum": 0 },
            "rate": { "type": "number", "minimum": 0, "maximum": 0.6 }
          }
        }
      }
    },
    "quarterDeadlines": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["q", "due", "periodStart", "periodEnd"],
        "properties": {
          "q": { "type": "integer", "minimum": 1, "maximum": 4 },
          "due": { "$ref": "#/definitions/isoDate" },
          "periodStart": { "$ref": "#/definitions/isoDate" },
          "periodEnd": { "$ref": "#/definitions/isoDate" }
        }
      }
    },
    "safeHarbor": {
      "type": "object",
      "required": ["basePct", "highIncomePct", "agiThresholdCents", "currentYearPct"],
      "properties": {
        "basePct": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
        "highIncomePct": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
        "agiThresholdCents": { "type": "integer", "minimum": 0 },
        "currentYearPct": { "type": "number", "minimum": 0.5, "maximum": 1.0 }
      }
    }
  }
}
